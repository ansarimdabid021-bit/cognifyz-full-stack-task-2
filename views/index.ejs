<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Cognifyz Task 2 | Smart Registration</title>

    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <div class="background">

        <div class="container">

            <div class="header">
                <span class="badge">COGNIFYZ • TASK 2</span>

                <h1>Smart Registration</h1>

                <p>
                    Complete the form to demonstrate
                    client-side and server-side validation.
                </p>
            </div>


            <form
                action="/submit"
                method="POST"
                id="registrationForm"
                onsubmit="return validateForm()"
            >

                <div class="form-grid">

                    <!-- Name -->
                    <div class="field">
                        <label>Full Name</label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            placeholder="Enter your full name"
                            oninput="checkName()"
                        >

                        <small id="nameError"></small>
                    </div>


                    <!-- Email -->
                    <div class="field">
                        <label>Email Address</label>

                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="you@example.com"
                            oninput="checkEmail()"
                        >

                        <small id="emailError"></small>
                    </div>


                    <!-- Age -->
                    <div class="field">
                        <label>Age</label>

                        <input
                            type="number"
                            id="age"
                            name="age"
                            placeholder="18 - 60"
                            min="18"
                            max="60"
                            oninput="checkAge()"
                        >

                        <small id="ageError"></small>
                    </div>


                    <!-- Role -->
                    <div class="field">
                        <label>Choose Role</label>

                        <select
                            id="role"
                            name="role"
                            onchange="checkRole()"
                        >

                            <option value="">Select your role</option>
                            <option value="Frontend Developer">
                                Frontend Developer
                            </option>

                            <option value="Backend Developer">
                                Backend Developer
                            </option>

                            <option value="Full Stack Developer">
                                Full Stack Developer
                            </option>

                            <option value="Student">
                                Student
                            </option>

                        </select>

                        <small id="roleError"></small>
                    </div>

                </div>


                <!-- Password -->
                <div class="field">

                    <label>Password</label>

                    <input
                        type="password"
                        id="password"
                        name="password"
                        placeholder="Minimum 6 characters"
                        oninput="checkPassword()"
                    >

                    <div class="password-meter">
                        <div id="passwordBar"></div>
                    </div>

                    <small id="passwordError"></small>

                </div>


                <!-- Message -->
                <div class="field">

                    <label>Why do you want to join?</label>

                    <textarea
                        id="message"
                        name="message"
                        rows="5"
                        placeholder="Write at least 10 characters..."
                        oninput="checkMessage()"
                    ></textarea>

                    <div class="character-count">
                        <span id="charCount">0</span>/300 characters
                    </div>

                    <small id="messageError"></small>

                </div>


                <!-- Terms -->
                <div class="terms">

                    <input
                        type="checkbox"
                        id="terms"
                        onchange="checkTerms()"
                    >

                    <label for="terms">
                        I confirm that the information provided is correct.
                    </label>

                </div>

                <small id="termsError"></small>


                <!-- Submit -->
                <button type="submit" id="submitBtn">
                    Submit Application
                    <span>→</span>
                </button>

            </form>


            <div class="footer">
                <span>Node.js</span>
                <span>•</span>
                <span>Express</span>
                <span>•</span>
                <span>EJS</span>
                <span>•</span>
                <span>JavaScript</span>
            </div>

        </div>

    </div>


    <!-- Inline JavaScript -->
    <script>

        function showError(id, message) {
            document.getElementById(id).textContent = message;
        }


        function checkName() {

            const name = document.getElementById("name").value.trim();

            if (name.length < 3) {
                showError("nameError", "Name must contain at least 3 characters.");
                return false;
            }

            showError("nameError", "✓ Looks good");
            return true;
        }


        function checkEmail() {

            const email = document.getElementById("email").value.trim();

            const pattern =
                /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

            if (!pattern.test(email)) {
                showError("emailError", "Enter a valid email.");
                return false;
            }

            showError("emailError", "✓ Valid email");
            return true;
        }


        function checkAge() {

            const age =
                Number(document.getElementById("age").value);

            if (age < 18 || age > 60 || !age) {
                showError(
                    "ageError",
                    "Age must be between 18 and 60."
                );

                return false;
            }

            showError("ageError", "✓ Age accepted");
            return true;
        }


        function checkRole() {

            const role =
                document.getElementById("role").value;

            if (!role) {
                showError("roleError", "Please select a role.");
                return false;
            }

            showError("roleError", "✓ Role selected");
            return true;
        }


        function checkPassword() {

            const password =
                document.getElementById("password").value;

            const bar =
                document.getElementById("passwordBar");

            if (password.length < 6) {

                bar.style.width = "30%";

                showError(
                    "passwordError",
                    "Password must contain at least 6 characters."
                );

                return false;
            }

            if (password.length < 10) {

                bar.style.width = "65%";

                showError(
                    "passwordError",
                    "Good password length."
                );

                return true;
            }

            bar.style.width = "100%";

            showError(
                "passwordError",
                "✓ Strong password"
            );

            return true;
        }


        function checkMessage() {

            const message =
                document.getElementById("message").value;

            document.getElementById("charCount").textContent =
                message.length;

            if (message.length < 10) {

                showError(
                    "messageError",
                    "Message must contain at least 10 characters."
                );

                return false;
            }

            showError(
                "messageError",
                "✓ Message accepted"
            );

            return true;
        }


        function checkTerms() {

            const checked =
                document.getElementById("terms").checked;

            if (!checked) {

                showError(
                    "termsError",
                    "Please confirm the information."
                );

                return false;
            }

            showError("termsError", "✓ Confirmed");

            return true;
        }


        function validateForm() {

            const nameValid = checkName();
            const emailValid = checkEmail();
            const ageValid = checkAge();
            const roleValid = checkRole();
            const passwordValid = checkPassword();
            const messageValid = checkMessage();
            const termsValid = checkTerms();

            return (
                nameValid &&
                emailValid &&
                ageValid &&
                roleValid &&
                passwordValid &&
                messageValid &&
                termsValid
            );
        }

    </script>

</body>

</html>